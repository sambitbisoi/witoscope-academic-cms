# Copy to .env (git-ignored). Never commit real values.

# cms_owner connection for migrations and importers. Never use service_role.
# Local (supabase start; this repo uses ports 5542x — witoscope-app owns 5432x):  postgres://cms_owner:<password>@127.0.0.1:55422/postgres
# Real project, pooler (session mode, port 5432); username is cms_owner.<project-ref>:
#   postgres://cms_owner.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
CMS_DATABASE_URL=

# Web app (Vite). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
