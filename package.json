{
  "name": "witoscope-academic-cms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "check-migrations": "tsx scripts/check-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local:bootstrap": "tsx scripts/local-bootstrap.ts",
    "test:db": "node node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "verify:uid": "tsx scripts/verify-uid.ts",
    "db:set-admin": "tsx scripts/set-admin.ts",
    "import:topics": "tsx scripts/import-topics.ts",
    "import:seed": "tsx scripts/import-seed.ts",
    "chapter": "tsx scripts/import-chapter.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "import:sources": "tsx scripts/import-sources.ts",
    "check:originality": "tsx scripts/check-originality.ts",
    "import:book": "tsx scripts/import-book.ts",
    "dev:files": "tsx scripts/dev-files.ts",
    "rehash": "tsx scripts/rehash.ts",
    "import:proposals": "tsx scripts/import-proposals.ts",
    "stage:pipeline": "tsx scripts/stage-pipeline.ts",
    "import:figures": "tsx scripts/import-figures.ts",
    "import:updates": "tsx scripts/import-updates.ts"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "exceljs": "4.4.0",
    "postgres": "3.4.5"
  },
  "workspaces": [
    "web"
  ]
}
