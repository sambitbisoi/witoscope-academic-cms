{
  "name": "witoscope-academic-cms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "check-migrations": "tsx --env-file-if-exists=.env scripts/check-migrations.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:ping": "tsx --env-file-if-exists=.env scripts/db-ping.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local:bootstrap": "tsx --env-file-if-exists=.env scripts/local-bootstrap.ts",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "verify:uid": "tsx --env-file-if-exists=.env scripts/verify-uid.ts",
    "db:set-admin": "tsx --env-file-if-exists=.env scripts/set-admin.ts"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "postgres": "3.4.5"
  }
}
